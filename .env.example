PORT=8787

# Optional: protect POST /api/run. Webhook endpoints use their own signatures.
PROOFSHIP_API_KEY=

# Automatic release verification
PROOFSHIP_GOAL=Verify the production deployment before declaring the release successful
PROOFSHIP_REPO=owner/repository
PROOFSHIP_CHECKS_JSON=[{"name":"Homepage loads","path":"/","expectStatus":200},{"name":"Checkout completes","path":"/checkout/health","expectStatus":200,"contains":"healthy","critical":true}]
PROOFSHIP_TARGET_URL=
# Production/custom-domain URL used to prove service restoration after a Vercel rollback.
PROOFSHIP_RECOVERY_TARGET_URL=
PROOFSHIP_AUTO_ROLLBACK=false
PROOFSHIP_RECOVERY_RETRIES=3
PROOFSHIP_RECOVERY_DELAY_MS=1500

# Generic signed release webhook: x-proofship-signature = sha256=<HMAC-SHA256>
PROOFSHIP_WEBHOOK_SECRET=

# OpenAI-compatible diagnosis layer (optional; deterministic fallback is built in)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini

# GitHub
GITHUB_TOKEN=

# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_WEBHOOK_SECRET=
# Optional explicit known-good deployment to restore. If omitted, ProofShip discovers the previous READY production deployment.
VERCEL_ROLLBACK_DEPLOYMENT_ID=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Linear personal API key + team UUID
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Optional live demo overrides. Default /api/demo is safe and simulated.
DEMO_LIVE_INTEGRATIONS=false
DEMO_REPO=
DEMO_SHA=
DEMO_PR_NUMBER=
DEMO_DEPLOYMENT_ID=
DEMO_VERCEL_PROJECT_ID=
DEMO_ROLLBACK_DEPLOYMENT_ID=
DEMO_TARGET_URL=
DEMO_AUTO_ROLLBACK=false
